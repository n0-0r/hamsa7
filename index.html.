<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>هدية خاصة 💝</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg,
      #4a0d1f 0%,
      #800020 20%,
      #ffffff 50%,
      #ffd1dc 70%,
      #ffd700 100%);
    background-size: 300% 300%;
    animation: bgShift 15s ease infinite;
    font-family: 'Segoe UI', 'Tahoma', sans-serif;
    overflow: hidden;
    position: relative;
    padding: 20px;
  }

  @keyframes bgShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  body::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 20% 30%, #ffd700, transparent),
      radial-gradient(2px 2px at 60% 70%, #ffffff, transparent),
      radial-gradient(1px 1px at 80% 20%, #ffd700, transparent),
      radial-gradient(2px 2px at 40% 80%, #ffffff, transparent),
      radial-gradient(1px 1px at 90% 60%, #fff, transparent),
      radial-gradient(1px 1px at 10% 90%, #ffd700, transparent),
      radial-gradient(2px 2px at 50% 50%, #ffb6c1, transparent);
    background-size: 200% 200%;
    animation: twinkle 8s infinite alternate;
    opacity: 0.8;
    pointer-events: none;
  }

  @keyframes twinkle {
    0% { background-position: 0% 0%; opacity: 0.5; }
    100% { background-position: 100% 100%; opacity: 1; }
  }

  .card {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 30px;
    padding: 50px 40px;
    max-width: 800px;
    width: 100%;
    text-align: center;
    border: 2px solid rgba(255, 215, 0, 0.6);
    box-shadow:
      0 0 40px rgba(255, 215, 0, 0.4),
      0 0 80px rgba(255, 105, 180, 0.3),
      inset 0 0 30px rgba(255, 255, 255, 0.3);
    animation: cardGlow 4s ease-in-out infinite alternate;
  }

  @keyframes cardGlow {
    from { box-shadow: 0 0 30px rgba(255,215,0,0.3), 0 0 60px rgba(255,105,180,0.2); }
    to   { box-shadow: 0 0 50px rgba(255,215,0,0.6), 0 0 100px rgba(255,105,180,0.4); }
  }

  #mediaContainer {
    opacity: 0;
    transform: scale(0.6) translateY(-30px);
    transition: all 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    margin-bottom: 30px;
  }

  #mediaContainer.show {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  #mediaContainer iframe {
    width: 100%;
    max-width: 640px;
    height: 360px;
    border-radius: 20px;
    border: 4px solid #ffffff;
    outline: 2px solid #ffd700;
    outline-offset: -8px;
    box-shadow:
      0 0 30px rgba(255, 215, 0, 0.7),
      0 0 60px rgba(255, 105, 180, 0.5),
      0 10px 30px rgba(128, 0, 32, 0.4);
    animation: mediaFloat 3s ease-in-out infinite;
  }

  @keyframes mediaFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  #message {
    font-size: 1.6rem;
    font-weight: bold;
    line-height: 1.7;
    background: linear-gradient(90deg, #800020, #ffd700, #ff69b4, #800020);
    background-size: 300% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shine 4s linear infinite;
    filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.5));
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  #message.show {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes shine {
    to { background-position: 300% center; }
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 1.6rem;
    background: #800020;
    margin-right: 5px;
    animation: blink 0.8s infinite;
    vertical-align: middle;
    box-shadow: 0 0 10px #ffd700;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .heart {
    position: fixed;
    font-size: 1.5rem;
    pointer-events: none;
    animation: floatUp linear forwards;
    z-index: 1;
  }

  @keyframes floatUp {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(-100vh) rotate(360deg); opacity: 0; }
  }

  @media (max-width: 600px) {
    #message { font-size: 1.1rem; }
    .card { padding: 30px 18px; }
    .cursor { height: 1.1rem; }
    #mediaContainer iframe { height: 240px; }
  }
</style>
</head>
<body>

<div class="card">
  <div id="mediaContainer">
    <!-- ✅ الفيديو الجديد -->
    <iframe 
      src="https://streamable.com/e/fxpz1m" 
      frameborder="0" 
      allowfullscreen 
      allow="autoplay; fullscreen">
    </iframe>
  </div>

  <h1 id="message"><span class="cursor"></span></h1>
</div>

<script>
/* ====== ✏️ عدّلي هنا ====== */
const MESSAGE = "أخيرًا طلعنا من أولى وإحنا سليمين… عقبال رابعة بقى عشان أنا زهقت 🥹 بس زعلانة إن باد الأربع سنين مش هنتقابل على طول كده 💔";
const TYPING_SPEED = 70;
const DELAY_BEFORE_MEDIA = 500;
const DELAY_BEFORE_TEXT = 1200;
/* ========================= */

const messageEl = document.getElementById('message');
const cursorEl = document.querySelector('.cursor');
const mediaContainer = document.getElementById('mediaContainer');

let i = 0;

function showMediaFirst() {
  mediaContainer.classList.add('show');
  startHearts();

  setTimeout(() => {
    messageEl.classList.add('show');
    setTimeout(typeWriter, 400);
  }, DELAY_BEFORE_TEXT);
}

function typeWriter() {
  if (i < MESSAGE.length) {
    cursorEl.insertAdjacentText('beforebegin', MESSAGE.charAt(i));
    i++;
    setTimeout(typeWriter, TYPING_SPEED);
  } else {
    setTimeout(() => {
      cursorEl.style.display = 'none';
    }, 800);
  }
}

window.addEventListener('load', () => {
  setTimeout(showMediaFirst, DELAY_BEFORE_MEDIA);
});

function createHeart() {
  const heart = document.createElement('div');
  heart.className = 'heart';
  const hearts = ['💖', '💝', '💗', '💕', '❤️', '✨', '🌟'];
  heart.textContent = hearts[Math.floor(Math.random() * hearts.length)];
  heart.style.left = Math.random() * 100 + 'vw';
  heart.style.bottom = '-50px';
  heart.style.fontSize = (Math.random() * 20 + 15) + 'px';
  heart.style.animationDuration = (Math.random() * 4 + 5) + 's';
  document.body.appendChild(heart);
  setTimeout(() => heart.remove(), 9000);
}

function startHearts() {
  setInterval(createHeart, 500);
}
</script>

</body>
</html>
